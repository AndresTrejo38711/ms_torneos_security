# Copia este archivo como .env (en esta misma carpeta) y llena los valores de tu PC.
# El .env no se sube al repo. Si una variable también existe en las variables de entorno de
# Windows (setx), gana la de Windows.
#
# Formato: NOMBRE=valor, sin comillas (las comillas quedarían como parte del valor) y sin espacios
# alrededor del "=". Si un valor tiene "\", escríbelo doble: "\\".

# Contraseña del usuario root de MySQL.
DB_PASSWORD=

# Clave con que se firman los tokens de sesión, de al menos 32 bytes. Se genera en cada PC
# (ver el README). Si se cambia, todos deben volver a iniciar sesión.
JWT_SECRET=

# Administrador inicial. Si el correo ya existe en la base, se conserva ese usuario y su contraseña:
# ADMIN_PASSWORD solo se usa la primera vez.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Login con Google y GitHub (HU-SE-08). Si no lo vas a probar, deja "pendiente": el resto funciona.
GOOGLE_CLIENT_ID=pendiente
GOOGLE_CLIENT_SECRET=pendiente
GITHUB_CLIENT_ID=pendiente
GITHUB_CLIENT_SECRET=pendiente

# Login con Microsoft, todavía sin implementar. Deben existir aunque sea con "pendiente".
MICROSOFT_CLIENT_ID=pendiente
MICROSOFT_CLIENT_SECRET=pendiente
